    "def add(a,b):\n",
    "    c = a + b\n",
    "    return c\n",
    "\n",
    "import numpy as np\n",
    "X=np.linspace(1,10,10)\n",
    "def sum_list(values):\n",
    "    total =0\n",
    "    for num in X:\n",
    "        total  = add(total,num)\n",
    "    return total\n",
    "\n",
    "sum=sum_list(X)\n",
    "print(sum)"
   ]
